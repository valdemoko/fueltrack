{
  "name": "fueltrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "npx tsx src/lib/db/seed.ts",
    "db:seed:miteco": "npx tsx src/lib/db/seed-miteco.ts",
    "db:seed:spain": "npx tsx src/lib/db/seed-spain.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@neon/config": "^1.7.3",
    "@neon/env": "^1.4.4",
    "@neondatabase/serverless": "^1.1.0",
    "@types/leaflet": "^1.9.22",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.44.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
