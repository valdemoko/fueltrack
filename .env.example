# ============================================================
# FuelTrack — Variables de entorno
# Copia este archivo a .env.local (dev) o configúralas en tu
# proveedor de hosting (producción). Las NEXT_PUBLIC_* se
# incrustan en tiempo de BUILD: si las cambias, redeploy.
# ============================================================

# ------------------------------------------------------------
# Base de datos: PostgreSQL (Neon).
#
#   DATABASE_URL            conexión con POOLER (la usa la app). Añade
#                           ?sslmode=require al final.
#   DATABASE_URL_UNPOOLED   conexión directa, SIN pooler. La usan los
#                           scripts (migraciones, migración de datos):
#                           el pooler en modo transacción es más frágil
#                           para DDL y cargas largas.
#
# Se copian del panel de Neon (Connection string) o con
# `neon connection-string` desde la CLI.
#
# NO hay modo "sin base de datos": el driver es HTTP y no abre ficheros,
# así que si falta DATABASE_URL la app arranca pero falla al consultar (con
# un error claro) en lugar de caer en tiempo de build.
#
# OJO: en Neon hay un LÍMITE DE TAMAÑO de proyecto (512 MB en Free). Al
# superarlo TODAS las escrituras fallan con "project size limit exceeded".
# Consulta el consumo con:  npx tsx scripts/smoke-neon.ts
# ------------------------------------------------------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ------------------------------------------------------------
# (Opcional) Rama de Neon para las PRUEBAS DESTRUCTIVAS.
# scripts/probar-mantenimiento.ts PURGA datos y reescribe medias
# mensuales, así que se niega a correr contra DATABASE_URL. Crea una
# rama desechable (copia instantánea, no duplica el almacenamiento):
#   neon branches create --project-id <id> --name pruebas --parent production
#   PRUEBA_DATABASE_URL="<connection string de la rama>" \
#     npx tsx scripts/probar-mantenimiento.ts --si
#   neon branches delete pruebas --project-id <id>
# ------------------------------------------------------------
PRUEBA_DATABASE_URL=

# ------------------------------------------------------------
# Secreto del endpoint /api/cron (Vercel Cron lo envía como
# "Authorization: Bearer <CRON_SECRET>" automáticamente, también en Hobby).
# Genera uno con: openssl rand -hex 32
# NO es NEXT_PUBLIC_: debe permanecer privado.
# ------------------------------------------------------------
CRON_SECRET=

# ------------------------------------------------------------
# URL canónica del sitio (sin barra final)
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://fueltrack.site

# ------------------------------------------------------------
# Google AdSense — publisher ID SIN el prefijo "ca-pub-".
# Ejemplo: si tu ID es ca-pub-1234567890123456, pon solo
# 1234567890123456. Vacío = AdSense desactivado por completo.
# ------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# ------------------------------------------------------------
# Slots de AdSense por emplazamiento (IDs numericos del panel
# de AdSense). Vacio = ese emplazamiento no se renderiza.
#   LISTADO   -> tras la tabla de gasolineras (municipio)
#   ESTACION  -> tras precios y comparacion (ficha de estacion)
# ------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_SLOT_LISTADO=
NEXT_PUBLIC_ADSENSE_SLOT_ESTACION=

# ------------------------------------------------------------
# CookieYes (CMP certificada por Google, obligatoria para
# servir anuncios personalizados en el EEE/GDPR).
# 1. Crea cuenta gratis en https://www.cookieyes.com
# 2. Añade el sitio y publica el banner (plantilla Legal, ES)
# 3. Copia la "Client Key" (32 caracteres hex) de
#    Website Settings → Installation
# Vacío = solo banner propio básico (NO certificada por Google).
# ------------------------------------------------------------
NEXT_PUBLIC_COOKIEYES_CLIENT_KEY=

# ------------------------------------------------------------
# Google Search Console — contenido del meta tag
# google-site-verification (solo el token, no el meta entero).
# ------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ------------------------------------------------------------
# (Opcional) Google Analytics 4 — ID de medición.
# Vacío = GA4 desactivado.
# ------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=
