{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Custom worker: reutiliza el worker generado por OpenNext y añade el
	// handler `scheduled` para el Cron Trigger (ver worker.ts).
	"main": "worker.ts",
	"name": "fueltrack",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Cron Trigger DIARIO a las 08:00 UTC (10:00 en España en verano, 09:00 en
	// invierno), igual que el cron de Vercel que sustituye. Cloudflare Cron
	// SIEMPRE usa UTC. MITECO publica un parte diario y las tablas de agregados
	// diarios (hist_geo_dia, precios_historico) necesitan ingesta cada día; el
	// proceso es idempotente (cron_progreso), así que repeticiones no duplican.
	"triggers": {
		"crons": ["0 8 * * *"]
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "fueltrack"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
